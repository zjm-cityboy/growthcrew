# 复制为 .env 后按需修改（.env 已被 .gitignore 排除，绝不提交）
# 所有变量带 GC_ 前缀，避免与系统变量冲突

# dev / prod（prod 下必须显式设置 GC_JWT_SECRET，否则启动即失败）
GC_ENV=dev

# 本地开发默认 SQLite；生产用 PostgreSQL（见 deploy/.env.example）
GC_DATABASE_URL=sqlite+aiosqlite:///./growthcrew.db

# 生产环境必须替换为随机长字符串（例：python -c "import secrets; print(secrets.token_urlsafe(48))"）
# GC_JWT_SECRET=

# 前端来源（CORS 白名单，JSON 数组格式）
# GC_CORS_ORIGINS=["http://localhost:3000"]
