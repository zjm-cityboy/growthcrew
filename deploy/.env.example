# 复制为 deploy/.env 并填写真实值（.env 已被 gitignore，绝不提交、绝不打包）
# 推荐直接运行一键脚本自动生成：Windows 双击 setup.bat / macOS-Linux 运行 ./setup.sh
#
# 手动生成随机密钥（任选其一）：
#   python:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
#   Fernet 主密钥（必须是 44 位 urlsafe）：
#            python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- 应用配置 ---
GC_ENV=prod
# 登录令牌签名密钥：48 字节随机 urlsafe
GC_JWT_SECRET=CHANGE_ME_TO_RANDOM_LONG_STRING
# BYOK 模型密钥的加密主密钥（Fernet 44 位 urlsafe）。注意：换掉它已保存的
# 模型密钥将无法解密，需在设置页重新录入
GC_ENCRYPTION_KEY=CHANGE_ME_TO_FERNET_KEY
# 前端访问来源（CORS 白名单）。默认端口 3211；若改了 compose 里的前端
# 端口映射，这里要同步改
GC_CORS_ORIGINS=["http://localhost:3211","http://127.0.0.1:3211"]
# 管理后台的管理员用户名（JSON 数组）。这些用户名必须由你本人先在应用里
# 注册，再填进来（先注册再配置，防同名抢注）。留空数组=无管理员。
GC_ADMIN_USERNAMES=[]

# --- 数据库（compose 内部使用） ---
POSTGRES_USER=growthcrew
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=growthcrew
