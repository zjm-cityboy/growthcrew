# 复制为 deploy/.env 并填写真实值（.env 已被 gitignore，绝不提交）
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# 对外域名（Caddy 用它自动签发 HTTPS 证书）
DOMAIN=gc.example.com

# --- 应用配置 ---
GC_ENV=prod
GC_JWT_SECRET=CHANGE_ME_TO_RANDOM_LONG_STRING
# BYOK 密钥加密主密钥（Fernet，44 位 urlsafe）——生成方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GC_ENCRYPTION_KEY=CHANGE_ME_TO_FERNET_KEY
# 前端上线后改为真实来源，例：["https://gc.example.com"]
GC_CORS_ORIGINS=["http://localhost:3000"]

# --- 数据库（compose 内部使用） ---
POSTGRES_USER=growthcrew
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=growthcrew
